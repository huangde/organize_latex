{
    "latex-workshop.latex.tools": [
        {
            "name": "precompile-preamble",
            "command": "etex",
            "args": [
                "-initialize",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-jobname=preamble",
                "&pdflatex",
                "mylatexformat.ltx",
                "main.tex"
            ]
        },
        {
            "name": "latexmk-precompiled",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-synctex=1",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Precompile preamble",
            "tools": [
                "precompile-preamble"
            ]
        },
        {
            "name": "Build with precompiled preamble",
            "tools": [
                "precompile-preamble",
                "latexmk-precompiled"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "Build with precompiled preamble"
}